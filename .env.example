# katgpt-rs environment template — copy to `.env` (gitignored, NEVER commit).
#
# Copy:  cp .env.example .env   then fill in/uncomment what you need.
#
# katgpt-rs does NOT auto-load `.env` (no dotenv/dotenvy, no script sources
# it). Every variable below is read from the PROCESS environment — export it,
# prefix the command (`FOO=1 cargo bench ...`), or load the file into your
# shell first:   set -a; . ./.env; set +a
#
# This repo has NO local secrets. The only credentials are GitHub Actions
# repo secrets (below, commented). Everything else is an optional runtime,
# bench, test, gate, or debug knob — all commented out, defaults noted.
# Rule for agents: values are never printed, never committed.

# ── GitHub Actions secrets (set in GitHub → Settings → Secrets, NOT via .env) ─
# Used by: .github/workflows/release-plz.yml (release PR + crates.io publish).
# CARGO_REGISTRY_TOKEN: crates.io API token with publish scope.
#   Get: https://crates.io/settings/tokens → New Token (publish-update scope).
#   Required only for the release-plz publish job.
# GITHUB_TOKEN: provided automatically by GitHub Actions — never set by hand.
# CARGO_REGISTRY_TOKEN=
# GITHUB_TOKEN=

# ── Runtime kill switches / overrides (library code, optional) ─────────────
# katgpt-types simd/spin_pool.rs: spin-pool worker count (default: macOS P-cores−1; elsewhere logical CPUs−1 when >=8, else 0 = rayon)
# KATGPT_SPIN_POOL_WORKERS=
# katgpt-types simd/spin_pool.rs: idle spin window in µs before workers park (default 100; `inf` = never park)
# KATGPT_SPIN_POOL_IDLE_US=100
# katgpt-types simd/plasma_dispatch.rs: L3 cache size override in bytes (default: OS probe, fallback 33554432 = 32 MiB)
# KATGPT_PLASMA_L3_BYTES=
# katgpt-attn mla.rs / flashmemory_sparse.rs: `1` forces the MLA reconstruct path instead of absorbed (default unset = absorbed)
# KATGPT_MLA_RECONSTRUCT=
# katgpt-core qrr_convergence.rs: `0` demotes the oscillation mode verdict to incumbent behavior (default unset = armed)
# KATGPT_QRR_OSC_VERDICT=
# katgpt-core tpr/mod.rs: `0` disables the TPR binding ops (kill switch; default unset = live)
# RIIR_TPR=
# katgpt-pruners exploration_budget.rs: per-tier exploration limits (defaults: tier0 u32::MAX, tier1 1000, tier2 100)
# KATGPT_TIER0_LIMIT=
# KATGPT_TIER1_LIMIT=1000
# KATGPT_TIER2_LIMIT=100
# katgpt-core ugc_schedule.rs: any value enables UGC schedule debug prints (default off; also read by tests/ugc_664_poc.rs)
# UGC_DEBUG=
# NOTE: katgpt-core escalation_guard::demote_only_env_armed(name) reads a
# CALLER-named kill switch (`0` demotes); no name is defined in this repo.

# ── Toolchain paths (katgpt-percepta compile pipeline, optional) ───────────
# katgpt-percepta compile.rs: explicit clang binary (default: `clang` on PATH, then Homebrew/Linux fallbacks)
# CLANG_PATH=
# katgpt-percepta compile.rs: explicit rustc binary (default: `rustc` on PATH)
# RUSTC_PATH=

# ── Model / data paths (benches, tests, examples, optional) ────────────────
# Kimi-K3 0.4B weights dir for benches/examples/scripts/kimi_ref (default: ./data/kimi-k3-0.40b, some fall back to ../riir-train/data/kimi-k3-0.40b)
# KIMI_K3_MODEL_DIR=
# tests/bench_612_pyramid_goat + issue_925_procrustes_probe: full fixture set dir (default unset = full-set lane skipped)
# PYRAMID_612_FULL_DIR=
# katgpt-speculative tests/weaver_real_checkpoint.rs: weaver checkpoint (default ../riir-train/output/weaver_real_trained/weaver_v1.safetensors)
# WEAVER_CHECKPOINT_PATH=
# benches/bench_683_stale_residual_poc.rs: trace dir (default $CARGO_MANIFEST_DIR/data/stale_residual_traces)
# STALE_RESIDUAL_TRACES=
# katgpt-core tests/bench_779_real_bank_affinity.rs: captured bank .bin + meta .json (required by that test, no default)
# BANK779_BIN=
# BANK779_JSON=
# katgpt-moka-wasm bench/bench_moka_side_by_side.mjs: moka repo checkout (default /tmp/moka-repo)
# MOKA_REPO=/tmp/moka-repo

# ── Kimi-K3 examples (kimi_k3_hello_world, kimi_k3_4b_hello_world) ─────────
# prompt text (default "Hello")
# KIMI_PROMPT=Hello
# decode token count (default 8)
# KIMI_N_TOKENS=8
# 4B example sampling seed (default 42)
# KIMI_K3_4B_SEED=42
# `1` skips the 4B example + tests/kimi_k3_4b_a3_forward_verify (default unset)
# KIMI_K3_4B_SKIP=

# ── K929 loop-alignment probe (examples/kimi_k3_loop_alignment_probe.rs) ───
# `1`/`true` = small smoke config (default off); defaults below are full / smoke
# K929_SMOKE=
# K929_ENTITIES=64          # smoke 32
# K929_RELATIONS=50         # smoke 8
# K929_OUT_DEGREE=6         # smoke 3
# K929_FACTS=8              # smoke 6
# K929_TWO_HOP=12           # smoke 3
# K929_ONE_HOP=16           # smoke 5
# K929_LOOPS=8              # smoke 4
# K929_ANSWER_MAX_TOKENS=12 # smoke 8
# K929_BOOTSTRAP_ITERS=2000 # smoke 500
# RNG seed (default 0x929 = 2345)
# K929_SEED=2345
# few-shot exemplar count (default 0)
# K929_EXEMPLARS=0
# `1`/`true` prepends BOS (default off)
# K929_BOS=
# cap on probe items (default unset = all)
# K929_MAX_ITEMS=
# write a JSON record to this path (default unset = no file)
# K929_OUT=

# ── FlashMemory benches (benches/bench_021/023/024) ─────────────────────────
# bench_021 sequence length (default 512)
# FLASHMEMORY_BENCH_SEQ=512
# block size (default 16)
# FLASHMEMORY_BLOCK_SIZE=16
# refresh period (default = block size)
# FLASHMEMORY_REFRESH_PERIOD=
# selection threshold (default 0.5)
# FLASHMEMORY_THRESHOLD=0.5
# bench_023 NIAH target sequence length (default 512)
# FLASHMEMORY_NIAH_SEQ=512
# bench_023 needle depth fraction (default 0.5)
# FLASHMEMORY_NIAH_DEPTH=0.5
# bench_024 comma-separated scale list (default 128,512,1024,2048,4096)
# FLASHMEMORY_SCALES=128,512,1024,2048,4096

# ── FlashMemory full-model NIAH QA (benches/bench_685) ─────────────────────
# single-key needle depth fraction (default 0.5)
# FFM_DEPTH=0.5
# comma-separated sequence lengths (default 2048,16384,65536)
# FFM_SEQ_LENS=2048,16384,65536
# multi-key lengths (default 16384,65536)
# FFM_MULTI_LENS=16384,65536
# comma-separated thresholds (default 0.5,0.7)
# FFM_THRESHOLDS=0.5,0.7
# block size (default 64)
# FFM_BLOCK_SIZE=64
# refresh period (default 64)
# FFM_REFRESH=64
# decode tokens (default 12)
# FFM_N_DECODE=12
# sigma-sweep lengths (default 16384,65536)
# FFM_SWEEP_LENS=16384,65536
# `question` = question-format prompt (default continuation stem)
# FFM_QUERY=
# `0` disables the parity check (default on)
# FFM_PARITY=
# `1` enables the probe pass (default off)
# FFM_PROBE=

# ── Go examples (examples/go_*.rs, tests/go_integration.rs) ────────────────
# AutoGo API URL (default http://localhost:8765)
# GO_URL=http://localhost:8765
# go_06_bench API URL (default unset = API section skipped)
# GO_API_URL=
# game count (default: go_01 20, go_02/03/05 10, go_10 50, go_11 20)
# GO_GAMES=
# board size (default 9)
# GO_BOARD=9
# go_01 MCTS budget (default 200)
# GO_BUDGET=200
# go_03/go_04 section set (default all); go_05 `quick` = quick set
# GO_SET=all
# go_04 episode count (default 500)
# GO_EPISODES=500
# go_04 `1` disables delta gating (default off)
# GO_NO_DELTA=
# go_05 baseline player `greedy` | random (default random)
# GO_BASELINE=
# go_05 any value = quick set (default off)
# GO_SET_QUICK=
# go_05 arms (default 10)
# GO_ARMS=10
# go_05 evals (default 50)
# GO_EVALS=50
# go_05 any value disables pruning (default off)
# GO_NO_PRUNE=
# go_05 any value enables MCTS (default off = greedy)
# GO_MCTS=
# go_10 burn-in games (default 50)
# GO_BURNIN=50
# go_10 GOAT games (default 100)
# GO_GOAT_GAMES=100
# go_11 matchups (default greedy,validator,hl,gzero,mcts,mcts-moka,moka-search)
# GO_MATCHUPS=greedy,validator,hl,gzero,mcts,mcts-moka,moka-search
# go_11 MCTS budget (default 200)
# GO_MCTS_BUDGET=200
# go_11 MCTS-moka budget (default 30)
# GO_MCTS_MOKA_BUDGET=30
# go_11 MCTS-moka depth (default 0)
# GO_MCTS_MOKA_DEPTH=0
# go_11 search depth (default 2)
# GO_SEARCH_DEPTH=2
# go_11 search top-k (default 8)
# GO_SEARCH_TOPK=8
# go_11 opening-book moves (default 6)
# GO_OPENING_BOOK_MOVES=6
# go_11 random opening moves (default 4)
# GO_OPENING_MOVES=4
# go_11 PUCT budget (default 100)
# GO_PUCT_BUDGET=100
# go_11 PUCT c (default 1.5)
# GO_PUCT_C=1.5
# go_11 `1` runs the forward-pass bench (default off)
# GO_BENCH_FORWARD=

# ── katgpt-core benches / tests ────────────────────────────────────────────
# bench_615: trees per setting (default 100)
# B615_TREES=100
# bench_615: any value = resolver A/B only, skips the gated suite (default off)
# B615_2FFS_AB=
# bench_615: any value enables lazy discharge (default off)
# B615_2FFS_LAZY=
# bench_615: any value enables node tracing (default off)
# B615_2FFS_TRACE=
# bench_615: any value enables debug prints (default off)
# B615_DEBUG=
# bench_615 A/B overrides (default: AbCfg::protocol() values)
# B615_AB_EPS=
# B615_AB_SIGMA=
# B615_AB_COST=
# bench_708: any value = verbose (default off)
# B708_VERBOSE=
# bench_410: `1` runs the scaling sweep (default off)
# LINKING_SCALING=
# bench_440: `1`/`true` enables multistep escalation (default off)
# LLLG_MULTISTEP=
# linking_detector prof_phase_breakdown (ignored test): sizes list (default 200) + ambient dim (default 8)
# LINKING_PROF_N=200
# LINKING_PROF_D=8
# tests/karc_reproducibility: any value writes the G4 audit dump (default off)
# KARC_G4_DUMP=
# tests/three_ball_paradigm: any value enables tracing (default off)
# TB_TRACE=

# ── Root crate tests (tests/bench_601, tests/bench_817) ────────────────────
# bench_601 train epochs (default 40)
# BENCH601_EPOCHS=40
# bench_601 Monte-Carlo samples (default 4096)
# BENCH601_MC=4096
# bench_817 train epochs (default 40)
# BENCH817_EPOCHS=40

# ── katgpt-attn / katgpt-types examples ────────────────────────────────────
# asentmax_p07_gen_fixture: any value toggles each debug arm (default off)
# ASE_P07_NO_YARN=
# ASE_P07_NO_MSCALE=
# ASE_P07_MSCALE_ONLY=
# ASE_P07_INTERLEAVE=
# ASE_P07_NO_QKNORM=
# q2_bandwidth_sweep: comma-separated thread counts (default <rayon threads>,8,10,12)
# Q2_BW_THREADS=
# spin_pool_gap_ab: worker count (default SpinPool::for_this_machine)
# SPIN_WORKERS=

# ── katgpt-extract GLiNER lane (tests/g5_span_baselines + tools/gliner_span_lane.py) ─
# predictions JSONL produced by tools/gliner_span_lane.py (default unset = lane SKIPPED)
# GLINER_SPAN_PRED=
# HF model id (default urchade/gliner_multi-v2.1)
# GLINER_MODEL=urchade/gliner_multi-v2.1
# span threshold (default 0.5)
# GLINER_THRESHOLD=0.5
# batch size (default 8)
# GLINER_BATCH=8

# ── Docs gate / drift sweeps (scripts/*.py) ────────────────────────────────
# `1` on a known partial-clone box: population axis DEFERRED, loud (default unset)
# DOCS_GATE_PARTIAL_CLONE=
# comma-separated repo NAMES present but not claimed by the contract (default unset; never `=1`)
# DOCS_GATE_KNOWN_EXTRA=
# `1` in single-checkout CI: defers the cross-repo axis (default unset)
# DOCS_GATE_CI=
# workspace root holding sibling repos (default: parent of this repo)
# WORKSPACE_ROOT=
# doc-sync linkcheck tools workspace root (default /Users/katopz/git)
# LINKCHECK_WORKSPACE=
# required_features_build_audit: min free disk GiB before building (default 8)
# RFBA_MIN_FREE_GIB=8
# arm_reach_audit: `mutant` = per-mutant progress lines (default per-module)
# ARM_REACH_PROGRESS=
# claim_lease_check: own session epoch, digits only (default: --epoch flag)
# CLAIM_LEASE_EPOCH=

# ── Shell gates (scripts/*.sh) ─────────────────────────────────────────────
# full_gate.sh: clippy log path, kept on pass too (default: mktemp, removed on pass)
# FULL_GATE_LOG=
# check_platform_gated_modules.sh: log path (default /tmp/platform_gated_check.log)
# PLATFORM_GATED_LOG=/tmp/platform_gated_check.log
# x86_64_execution_matrix.sh: extraction dir, kept after run (default: mktemp, removed)
# X86_MATRIX_DIR=
# x86_64_execution_matrix.sh: parallel jobs (default 6)
# X86_MATRIX_JOBS=6
# x86_64_execution_matrix.sh: alone re-runs per failure (default 3)
# CONFIRM_RUNS=3
# x86_64_execution_matrix.sh: cmake build parallelism (default unset; forced to 1 on MINGW/MSYS/Cygwin)
# CMAKE_BUILD_PARALLEL_LEVEL=
