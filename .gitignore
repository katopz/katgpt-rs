/target

# katgpt-moka-wasm build output (scripts/build-moka-wasm.sh)
# The SIMD-enabled .wasm + JS glue lands here; rebuild with the script.
/crates/katgpt-moka-wasm/target-wasm/
.raw
checkpoints/
output/
.logs

# Training checkpoint artifacts (PoC runs, should not ship)
/go_lora*.bin
/domino_lora*.bin

# Trained model artifacts — must never ship in public MIT repo.
# Trained weights belong in riir-train (source) / riir-ai/assets (runtime).
*.mlpackage/
*.mlmodel

# Python — scripts/ ships re-runnable auditors/builders; bytecode cache should not ship.
__pycache__/
*.pyc

# Cloudflare
.wrangler

# Local agent tool configuration (Claude Code, etc.)
.claude/
data/kimi-k3-0.40b/
# Issue 691 stale-residual traces (derived data from riir-ai's
# stale_residual_trace_dump example; regenerate with that example —
# see .benchmarks/683_stale_residual_poc.md).
data/stale_residual_traces/
# Kimi-K3 layer-diff debug artifacts (regenerable via scripts/kimi_ref/run_reference.py + dump_layer*.py)
scripts/kimi_ref/ref_output/

# Symlink to AGENTS.md so Claude Code reads the same instructions as Zed's agent
CLAUDE.md

# Stray process output. `git add -A` from the repo root is indistinguishable
# from intent (AGENTS.md §shared worktree), and several sessions write here at
# once — an untracked nohup.out is a landmine, not a file anyone means to keep.
nohup.out

# Machine-local on-disk → contract repo-name map for the derived workspace
# walk (scripts/repo_alias.py). Content is private by design — never committed.
scripts/repo_alias.local.txt

# cargo-refine machine-local state (trajectories, fixseq, outbox, active-set)
.refine/

# session run scratch (gate out/err logs)
.runs/
# local env (template: .env.example)
.env
